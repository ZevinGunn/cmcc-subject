{
  "name": "cookie-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "test:release": "node --import tsx api/tests/release-unit.ts",
    "test:legacy-business": "node --import tsx api/tests/legacy-business-unit.ts",
    "test:api": "node --import tsx api/tests/api-unit.ts && node --import tsx api/tests/cmcc-business-unit.ts && node --import tsx api/tests/qqt-activity-unit.ts && npm run test:global-daily && node --import tsx api/tests/accounts-store-unit.ts && node --import tsx api/tests/access-log-unit.ts && npm run test:lucky-bag && npm run test:yunpan && npm run test:wed-toolbox-bridge && npm run test:wed-stock && npm run test:starbucks",
    "test:age-feed": "node --import tsx api/tests/age-feed-unit.ts",
    "test:coc-sso": "node --import tsx api/tests/coc-sso-unit.ts",
    "test:global-daily": "node --import tsx --test api/tests/global-telecom-daily.test.ts",
    "global-daily:configure": "node --import tsx api/scripts/global-telecom-daily.ts",
    "test:wed-stock": "node --import tsx --test api/tests/wed-coupon-stock.test.ts",
    "wed-stock:status": "node --import tsx api/scripts/wed-coupon-stock-monitor.ts",
    "test:wed-toolbox-bridge": "node --import tsx --test api/tests/toolbox-import.test.ts",
    "test:lucky-bag": "node --import tsx api/tests/lucky-bag-unit.ts",
    "test:yunpan": "node --import tsx api/tests/yunpan-sso-unit.ts && node --import tsx api/tests/qqt-sso-unit.ts",
    "test:yunpan-browser": "node src/tests/yunpan-browser.mjs",
    "test:account-menu-browser": "node src/tests/public-account-menu-browser.mjs",
    "test:account-sort-browser": "node src/tests/public-account-sort-browser.mjs",
    "test:starbucks": "node --import tsx --test api/tests/starbucks.test.ts",
    "test:starbucks-browser": "node src/tests/starbucks-browser.mjs",
    "test:brand-browser": "node src/tests/brand-browser.mjs",
    "starbucks:configure": "node --import tsx api/scripts/starbucks-protocol.ts",
    "test:qqt-broadband-browser": "node src/tests/qqt-premium-broadband-browser.mjs",
    "test:ui": "node --import tsx src/tests/ui-unit.tsx",
    "test:callback": "node --import tsx api/tests/callback-unit.ts",
    "test:wed-puzzle": "node --import tsx api/tests/wed-puzzle-unit.ts",
    "test": "npm run test:api && npm run test:legacy-business && npm run test:age-feed && npm run test:coc-sso && npm run test:ui",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:import": "node --import tsx api/scripts/import-json-to-db.ts",
    "db:import:if-empty": "node --import tsx api/scripts/import-json-if-db-empty.ts",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:init": "bash scripts/db-init.sh",
    "credentials:init": "bash scripts/credentials-db-init.sh",
    "credentials:migrate": "bash scripts/credentials-db-migrate.sh",
    "credentials:clear-legacy": "node --import tsx api/scripts/clear-legacy-account-credentials.ts",
    "db:migrate:legacy-to-docker": "bash scripts/db-migrate-legacy-to-docker.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:backup:legacy": "bash scripts/db-backup-legacy.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:retire:legacy": "bash scripts/db-retire-legacy.sh",
    "setup:env": "bash scripts/setup-env.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "start:server": "bash scripts/start-server.sh",
    "ck:maintenance": "node --import tsx api/scripts/ck-maintenance.ts",
    "test:cmcc-auto-checkin": "node --import tsx api/tests/cmcc-auto-checkin-unit.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "clsx": "^2.1.1",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "playwright": "1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "sanitize-html": "^2.17.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/sortablejs": "^1.15.9",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
