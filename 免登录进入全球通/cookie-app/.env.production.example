APP_ENV=production
USE_DOCKER_POSTGRES=1
PORT=3101
VITE_API_PORT=3101

ADMIN_KEY=replace-with-a-long-random-key
ADMIN_PATH=/_cmcc-prod
VITE_ADMIN_PATH=/_cmcc-prod

WORKER_DRIVER=go
GO_WORKER_URL=http://127.0.0.1:9011
GO_WORKER_KEY=replace-with-worker-key
WORKER_CONCURRENCY=6

CMCC_DEBUG_HTTP=0
CMCC_DEBUG_HTTP_MAX_BODY=4000
CMCC_VALIDITY_WINDOW_MIN=90

DATABASE_URL="postgresql://cmcc_user:CHANGE_ME_PASSWORD@10.0.0.20:55432/cmcc_cookie_app_prod?schema=public"
CMCC_DB_ENCRYPTION_KEY="base64-32-bytes"

PG_BACKUP_DIR=./backups/production
PG_BACKUP_RETENTION_DAYS=30
