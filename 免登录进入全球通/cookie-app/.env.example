PORT=3101
VITE_API_PORT=3101

APP_ENV=development
USE_DOCKER_POSTGRES=1

CMCC_DEBUG_HTTP=0
CMCC_DEBUG_HTTP_MAX_BODY=8000

# Admin UI access key (must be replaced before startup)
ADMIN_KEY=replace-with-a-long-random-key

# Admin UI path (keep private, e.g. /_ZevinGunn)
ADMIN_PATH=/_ZevinGunn
VITE_ADMIN_PATH=/_ZevinGunn

# V2 admin UI rollout switch. Set to 0 to disable /v2 and keep V1 only.
VITE_UI_V2_ENABLED=1

# Worker driver: node (default) or go
WORKER_DRIVER=node

# Go worker base URL when WORKER_DRIVER=go
GO_WORKER_URL=http://127.0.0.1:9011

# Optional shared key for Go worker
GO_WORKER_KEY=change-me

# Worker concurrency for node-side fallback
WORKER_CONCURRENCY=4

# Treat cookie/token as valid within this window (minutes) and skip upstream refresh.
CMCC_VALIDITY_WINDOW_MIN=90

# PostgreSQL is mandatory.
DATABASE_URL="postgresql://USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/cmcc_cookie_app?schema=public"

# Dedicated PostgreSQL database for encrypted 10086 CK and QQT token values.
CREDENTIALS_DATABASE_URL="postgresql://USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/cmcc_credentials?schema=public"

# Data at rest encryption (required).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CMCC_DB_ENCRYPTION_KEY="base64-32-bytes"

# Backup output directory and retention.
PG_BACKUP_DIR=./backups
PG_BACKUP_RETENTION_DAYS=14

# Scheduled database backup and expired/history data cleanup.
DB_MAINTENANCE_ENABLED=true
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24
DB_CLEANUP_ENABLED=true
DB_CLEANUP_INTERVAL_HOURS=24
DB_SESSION_RETENTION_DAYS=7
DB_LOG_RETENTION_DAYS=30
DB_TASK_RETENTION_DAYS=30
DB_SCHEDULE_FIRE_RETENTION_DAYS=30
DB_DAILY_STATE_RETENTION_DAYS=90
