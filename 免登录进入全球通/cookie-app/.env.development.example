APP_ENV=development
USE_DOCKER_POSTGRES=1
PORT=3101
VITE_API_PORT=3101

ADMIN_KEY=replace-with-a-long-random-key
ADMIN_PATH=/_cmcc-dev
VITE_ADMIN_PATH=/_cmcc-dev

WORKER_DRIVER=node
GO_WORKER_URL=http://127.0.0.1:9011
GO_WORKER_KEY=replace-with-worker-key
WORKER_CONCURRENCY=4

CMCC_DEBUG_HTTP=1
CMCC_DEBUG_HTTP_MAX_BODY=8000
CMCC_VALIDITY_WINDOW_MIN=90

DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@127.0.0.1:55432/cmcc_cookie_app_dev?schema=public"
CREDENTIALS_DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@127.0.0.1:55432/cmcc_credentials?schema=public"
CMCC_DB_ENCRYPTION_KEY="base64-32-bytes"

PG_BACKUP_DIR=./backups/development
PG_BACKUP_RETENTION_DAYS=7
