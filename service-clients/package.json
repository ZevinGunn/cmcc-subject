{
  "name": "suixing-toolbox-clients",
  "version": "0.2.0",
  "private": true,
  "description": "随行工具箱跨平台客户端",
  "author": "CMCC Project",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "test:desktop-security": "node tests/desktop-security.cjs",
    "test:android": "node tests/android-smoke.cjs",
    "tools:cache": "node scripts/cache-build-tools.cjs",
    "icons": "node scripts/icons.cjs",
    "build:mac": "npm run icons && electron-builder --mac dmg zip --arm64 --x64",
    "build:win": "npm run icons && electron-builder --win nsis portable --x64",
    "build:android": "bash scripts/build-android.sh",
    "check": "npm test && node --check desktop/main.cjs && node --check desktop/renderer.cjs && node --check miniprogram/utils/api.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "png-to-ico": "3.0.1",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "xyz.1008086.suixing",
    "productName": "随行工具箱",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "artifacts/desktop",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "shared/**/*",
      "assets/icon.png",
      "assets/icon.svg",
      "package.json"
    ],
    "asar": true,
    "toolsets": { "nsis": "1.2.1" },
    "artifactName": "Suixing-Toolbox-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "identity": null,
      "minimumSystemVersion": "12.0.0"
    },
    "dmg": {
      "title": "随行工具箱",
      "window": {
        "width": 540,
        "height": 360
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Suixing-Toolbox-${version}-windows-${arch}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "随行工具箱",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "portable": { "artifactName": "Suixing-Toolbox-${version}-windows-${arch}-Portable.exe" }
  }
}
