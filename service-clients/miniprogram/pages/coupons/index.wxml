<view class="page">
  <view class="row"><view class="heading">星巴克卡券</view><button class="small secondary" bindtap="reload" loading="{{busy}}" disabled="{{busy}}">刷新</button></view>
  <view wx:if="{{!authenticated}}" class="empty">请先登录站点账号<button class="primary" bindtap="login">登录</button></view>
  <block wx:else>
    <view class="actions"><button class="secondary" bindtap="openLogin">添加号码</button><button class="primary" bindtap="copyAll" disabled="{{busy || !coupons.length}}">复制筛选券码</button></view>
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="section row"><text>卡券类型</text><text>{{categories[categoryIndex]}} ›</text></view></picker>
    <input class="field" placeholder="筛选手机号或卡券名称" value="{{keyword}}" bindinput="search" />
    <view class="muted">{{coupons.length}} 张可用卡券 · {{accounts.length}} 个号码</view><view class="spacer"></view>
    <view wx:if="{{!coupons.length && !busy}}" class="empty">暂无符合筛选条件的可用卡券</view>
    <view wx:for="{{coupons}}" wx:key="key" class="section"><view class="name">{{item.title}}</view><view class="muted">{{item.phoneMasked}} · {{item.expiryText || '有效期未知'}}</view><view class="spacer"></view><button class="secondary small" data-key="{{item.key}}" bindtap="copyOne" disabled="{{busy || !item.codeAvailable || item.invalidAt}}">{{item.invalidAt ? '账号需补登' : '查看并复制券码'}}</button></view>
  </block>
  <view wx:if="{{loginOpen}}" class="overlay" bindtap="closeLogin"><view class="dialog" catchtap="noop"><view class="dialog-title">登录星巴克</view><input class="field" type="number" maxlength="20" value="{{phone}}" bindinput="phoneInput" placeholder="手机号" /><view class="row"><input class="field" style="flex:1;min-width:0" type="number" maxlength="6" value="{{pin}}" bindinput="pinInput" placeholder="4 位验证码" /><button class="secondary small" bindtap="sms" disabled="{{busy || cooldown > 0}}">{{cooldown > 0 ? cooldown + 's' : '发送验证码'}}</button></view><view class="actions"><button class="secondary" bindtap="closeLogin" disabled="{{busy}}">取消</button><button class="primary" bindtap="submitLogin" loading="{{busy}}" disabled="{{busy}}">登录</button></view></view></view>
</view>
