page{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1c2733;background:#f6f7f9;font-size:28rpx;line-height:1.5}.page{padding:28rpx;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.heading{font-size:38rpx;font-weight:600;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section{background:white;border:1rpx solid #e1e6eb;border-radius:12rpx;padding:24rpx;margin-bottom:20rpx}.muted{color:#66717e;font-size:25rpx}.label{font-size:26rpx;margin-bottom:10rpx}.field{background:white;border:1rpx solid #c7d0d9;border-radius:10rpx;min-height:88rpx;padding:0 20rpx;margin-bottom:20rpx;box-sizing:border-box}.primary{background:#007caf!important;color:white!important}.secondary{background:white!important;color:#263644!important;border:1rpx solid #c7d0d9}.danger{color:#ac2331!important}button{font-size:28rpx;border-radius:10rpx;min-height:88rpx;line-height:88rpx;margin:0}button::after{border:0}button[disabled]{opacity:.45}.small{font-size:25rpx;min-height:64rpx;line-height:64rpx;padding:0 20rpx}.empty{text-align:center;padding:70rpx 24rpx}.empty button{margin-top:24rpx}.list-row{padding:22rpx 0;border-bottom:1rpx solid #e5e9ee}.list-row:last-child{border:0}.name{font-weight:600;font-size:31rpx;overflow-wrap:break-word}.good{color:#00754a}.warn{color:#a64b00}.actions{display:flex;gap:16rpx;margin:20rpx 0}.actions button{flex:1}.badge{font-size:24rpx;color:#66717e}.overlay{position:fixed;inset:0;background:rgba(20,31,42,.38);z-index:20;display:flex;align-items:center;justify-content:center;padding:28rpx}.dialog{background:white;border-radius:14rpx;padding:28rpx;width:100%;max-height:84vh;box-sizing:border-box}.dialog-title{font-size:34rpx;font-weight:600;margin-bottom:24rpx}.dialog-body{max-height:58vh}.spacer{height:16rpx}
