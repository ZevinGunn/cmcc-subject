{
  "name": "cmcc-contract-query",
  "version": "1.0.0",
  "private": true,
  "description": "北京移动合约版本对比与网格通业务统一查询服务",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --test",
    "build": "npm run check",
    "test": "node --test",
    "import:type2": "node scripts/import_type2.js",
    "import:type3": "python3 scripts/import_xls.py",
    "import:low": "python3 scripts/import_low_contracts.py",
    "import:xlsx": "python3 scripts/import_workbooks.py",
    "grid:summary": "node scripts/grid-catalog.js summary",
    "grid:collect": "node scripts/grid-catalog.js collect",
    "grid:discover": "node scripts/grid-catalog.js discover",
    "grid:export": "node scripts/grid-catalog.js export"
  }
}
